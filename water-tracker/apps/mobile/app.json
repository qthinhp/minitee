{
  "expo": {
    "name": "Water Tracker",
    "slug": "water-tracker",
    "version": "0.1.0",
    "scheme": "minitee",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.minitee.watertracker",
      "associatedDomains": ["applinks:minitee.app"],
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.minitee.watertracker"]
      },
      "infoPlist": {
        "NFCReaderUsageDescription": "Scan the sticker on your water bottle to log a drink."
      }
    },
    "android": {
      "package": "app.minitee.watertracker",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "minitee.app", "pathPrefix": "/t/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": ["android.permission.NFC"]
    },
    "plugins": [
      "expo-dev-client",
      "expo-notifications",
      "@bacons/apple-targets",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Scan your bottle sticker to log water",
          "selectIdentifiers": [],
          "includeNdefEntitlement": true
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Hydration",
              "label": "Water Tracker",
              "description": "Today's water at a glance",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
